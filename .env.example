# The configuration a certcrypt-node deployment sets: a template for the
# environment file your process manager loads (a systemd EnvironmentFile, or the
# file scripts/run_node.sh sources through CERTCRYPT_ENV_FILE). The node reads
# process environment only; it has no .env loader of its own. No real values
# here: copy it, fill it, keep the copy out of version control.
#
# This is the complete runtime mold. Keep every line when creating the real
# environment file; replace placeholders and protect that file from disclosure.

# -------- Runtime --------
# Where the node listens. Keep it on loopback behind your TLS reverse proxy.
NODE_BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# -------- Upstream: the issuance service the node forwards to --------
CERTCRYPT_API_URL=
# No shared bearer: recognition and possession travel with each signed request.
CERTCRYPT_API_TIMEOUT_SECS=10
CERTCRYPT_API_CONNECT_TIMEOUT_SECS=3

# -------- System domain the node trusts --------
# Issuer Level-1 proofs are verified OFFLINE against the system-domain public key
# published in this signed statement (system-foundation/1). The node uses a
# verified local cache; if it is absent or invalid, it downloads the statement
# from CERTCRYPT_API_URL/v1/system-foundation (or the optional URL override),
# verifies it first, then installs the cache atomically. A valid cache keeps
# later restarts independent from a live API.
CERTCRYPT_SYSTEM_ROOT_FINGERPRINT=REPLACE_ME
CERTCRYPT_SYSTEM_FOUNDATION_PATH=system-foundation.json
# Optional mirror/discovery override. Empty derives the URL from
# CERTCRYPT_API_URL. This is transport only and never replaces the fingerprint.
CERTCRYPT_SYSTEM_FOUNDATION_URL=
# Rules domains this deployment runs under that are not published, as
# comma-separated rules/<name>=<commitment_ttl_seconds>. Empty for a node that
# only carries published domains. A published domain cannot be redeclared, and a
# malformed value stops the boot.
NODE_DEPLOYMENT_RULES=

# -------- Durable state --------
# File-backed SQLite stores, so a restart keeps the journal and the outbox.
# ":memory:" for a throwaway run.
NODE_JOURNAL=node-journal.sqlite
NODE_OUTBOX=node-outbox.sqlite
NODE_JOURNAL_RETENTION_DAYS=30

# -------- Operator identity --------
# The operator key (NOT an issuer key, NOT the system-domain key) that signs an
# operator receipt per transported submission set. Both halves are required:
# without them the node does not start (generate them with the gen_operator_key
# example).
CERTCRYPT_NODE_OPERATOR_SK_B64=
CERTCRYPT_NODE_OPERATOR_PK_B64=
# The system-domain-signed recognition credential (operator.recognition/1),
# base64 of its JSON. The node presents it with every submission and every
# domain-binding registration; without it the node does not start.
CERTCRYPT_NODE_OPERATOR_CREDENTIAL_B64=

# -------- Declared operator domain (operator.domain-binding/1, optional) --------
# A host name to associate with the operator key. Empty: no association, and
# the node carries submissions exactly the same way. An internationalized name
# is accepted and converted to its ASCII form; a name that cannot be associated
# stops the boot.
CERTCRYPT_NODE_OPERATOR_DOMAIN=
# Sequence numbers and published statements. Keep it with the operator key:
# a sequence is never reused.
NODE_DOMAIN_BINDING_STATE=node-domain-binding.json
# The file to serve at https://<host>/.well-known/certcrypt-node.json.
NODE_WELL_KNOWN_FILE=certcrypt-node.json
# 1: the node answers GET /.well-known/certcrypt-node.json itself, for a node
# reached through the declared host. Only one node behind a host may do it.
NODE_SERVE_WELL_KNOWN=0

# -------- Admission and delivery limits --------
NODE_MAX_COMMITMENTS_PER_REQUEST=10000
NODE_MAX_CONCURRENT_REQUESTS=64
NODE_REQUEST_TIMEOUT_SECONDS=30
NODE_RELAY_TICK_MS=1000
NODE_RELAY_BATCH=32
NODE_RELAY_BACKOFF_CAP_SECS=300
NODE_RELAY_MAX_ATTEMPTS=12

# -------- Graceful restart --------
NODE_RESTART_RETRY_AFTER_SECS=10
NODE_SHUTDOWN_DRAIN_SECS=3

# -------- Operations: GET /ops --------
# Bearer token that opens GET /ops (build, uptime, memory, recent log lines).
# Empty: /ops answers 404.
NODE_OPS_TOKEN=
